+def _cells_in_bbox(sp, bbox: BoundingBox, ios: float = 0.8):
+    r"""
+    SegmentedPage.get_cells_in_bbox(TextCellUnit.WORD, bbox) without deep-copying
+    every word cell of the page: the matching cells and their rects in the
+    coordinate origin of bbox (what the copies returned there carry).
+    """
+    cells, rects = [], []
+    height = sp.dimension.height
+    for cell in sp.iterate_cells(TextCellUnit.WORD):
+        rect = cell.rect
+        if rect.coord_origin != bbox.coord_origin:
+            if bbox.coord_origin == CoordOrigin.TOPLEFT:
+                rect = rect.to_top_left_origin(height)
+            elif bbox.coord_origin == CoordOrigin.BOTTOMLEFT:
+                rect = rect.to_bottom_left_origin(height)
+        if rect.to_bounding_box().intersection_over_self(bbox) > ios:
+            cells.append(cell)
+            rects.append(rect)
+    return cells, rects
+
