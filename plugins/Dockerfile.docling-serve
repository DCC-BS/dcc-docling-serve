ARG DOCLING_SERVE_IMAGE=ghcr.io/docling-project/docling-serve
ARG DOCLING_SERVE_TAG=latest
FROM ${DOCLING_SERVE_IMAGE}:${DOCLING_SERVE_TAG}

# GPU images: run RapidOCR's onnxruntime on the GPU instead of the CPU (no-op on CPU images)
ARG ONNXRUNTIME_CUDA12_INDEX=https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-12/pypi/simple/
COPY install_onnxruntime_gpu.sh /tmp/install_onnxruntime_gpu.sh
RUN ONNXRUNTIME_CUDA12_INDEX="${ONNXRUNTIME_CUDA12_INDEX}" sh /tmp/install_onnxruntime_gpu.sh install
USER 0
RUN sh /tmp/install_onnxruntime_gpu.sh register-libs
# Back to the upstream image's user
USER 1001

# Pinned so a plugin release changes this layer; unpinned, the CD layer cache kept the old plugins
# renovate: datasource=pypi depName=docling-glm-ocr
ARG DOCLING_GLM_OCR_VERSION=0.5.2
# renovate: datasource=pypi depName=docling-pp-doc-layout
ARG DOCLING_PP_DOC_LAYOUT_VERSION=0.2.6
# renovate: datasource=pypi depName=docling-pp-ocrv6
ARG DOCLING_PP_OCRV6_VERSION=0.2.0
RUN pip install --no-cache-dir "huggingface-hub>=1.3.0" \
    && pip install --no-cache-dir --no-deps \
        "docling-glm-ocr==${DOCLING_GLM_OCR_VERSION}" \
        "docling-pp-doc-layout==${DOCLING_PP_DOC_LAYOUT_VERSION}" \
        "docling-pp-ocrv6==${DOCLING_PP_OCRV6_VERSION}"

# Bake the PP-DocLayout-V3 weights into the image: the plugin loads them from disk instead of
# fetching them from huggingface.co at every pipeline start (PP_DOC_LAYOUT_MODEL_NAME still overrides)
ARG PP_DOC_LAYOUT_MODEL_REPO=PaddlePaddle/PP-DocLayoutV3_safetensors
ARG PP_DOC_LAYOUT_MODEL_REVISION=e4f489dc536556fc1be02b973ba06756e0d4a2ac
ENV PP_DOC_LAYOUT_MODEL_NAME=/opt/app-root/src/.cache/docling/models/PaddlePaddle--PP-DocLayoutV3_safetensors
RUN python -c "import os, sys; from huggingface_hub import snapshot_download; \
snapshot_download(sys.argv[1], revision=sys.argv[2], local_dir=os.environ['PP_DOC_LAYOUT_MODEL_NAME'], \
allow_patterns=['*.json', '*.safetensors'])" "${PP_DOC_LAYOUT_MODEL_REPO}" "${PP_DOC_LAYOUT_MODEL_REVISION}" \
    && rm -rf "${PP_DOC_LAYOUT_MODEL_NAME}/.cache" \
    && python -c "import os; from transformers import AutoConfig; AutoConfig.from_pretrained(os.environ['PP_DOC_LAYOUT_MODEL_NAME'])"

# Bake the PP-OCRv6 models (medium, ~134 MB) where docling-serve's artifacts path points: the plugin
# loads them from disk instead of fetching them from huggingface.co in every new pod. Pinned like the
# layout weights, so a new upload to the repos changes nothing until the revisions here change.
ARG PP_OCRV6_DET_REPO=PaddlePaddle/PP-OCRv6_medium_det_onnx
ARG PP_OCRV6_DET_REVISION=61323801669c338b7891481ec7bac61ce31b576a
ARG PP_OCRV6_REC_REPO=PaddlePaddle/PP-OCRv6_medium_rec_onnx
ARG PP_OCRV6_REC_REVISION=50c7eacafc52fa7bcf4194e8cd08e46f8558504b
RUN python -c "import os, sys; from pathlib import Path; from huggingface_hub import snapshot_download; \
from docling_pp_ocrv6.model import PPOCRv6Model; \
models = Path(os.environ['DOCLING_SERVE_ARTIFACTS_PATH']) / 'PPOCRv6'; \
[snapshot_download(repo, revision=rev, local_dir=models / part, allow_patterns=['inference.onnx', 'inference.yml']) \
 for part, repo, rev in (('det', sys.argv[1], sys.argv[2]), ('rec', sys.argv[3], sys.argv[4]))]; \
PPOCRv6Model._ensure_rec_keys(models / 'rec')" \
        "${PP_OCRV6_DET_REPO}" "${PP_OCRV6_DET_REVISION}" "${PP_OCRV6_REC_REPO}" "${PP_OCRV6_REC_REVISION}" \
    && find "${DOCLING_SERVE_ARTIFACTS_PATH}/PPOCRv6" -name .cache -type d -prune -exec rm -rf {} +

# Mute health-probe log records (site-packages drop-in, no upstream file touched)
COPY mute_health_logs.py /tmp/mute_health_logs.py
RUN SP="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && cp /tmp/mute_health_logs.py "$SP/dcc_mute_health_logs.py" \
    && printf 'import dcc_mute_health_logs\n' > "$SP/zz_dcc_mute_health_logs.pth"

# Vector shapes no longer send programmatic PDF text to OCR (DCC_OCR_IGNORE_SHAPES=0 restores docling's behaviour)
COPY ocr_ignore_shapes.py /tmp/ocr_ignore_shapes.py
RUN SP="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && cp /tmp/ocr_ignore_shapes.py "$SP/dcc_ocr_ignore_shapes.py" \
    && printf 'import dcc_ocr_ignore_shapes\n' > "$SP/zz_dcc_ocr_ignore_shapes.pth"

# The convert API can hand back the words of each page and where they stand
# (DCC_WORD_BOXES=0 leaves the API as upstream has it)
COPY word_boxes.py /tmp/word_boxes.py
RUN SP="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && cp /tmp/word_boxes.py "$SP/dcc_word_boxes.py" \
    && printf 'import dcc_word_boxes\n' > "$SP/zz_dcc_word_boxes.pth"
