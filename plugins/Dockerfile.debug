# Dockerfile.debug — build docling-serve with plugins installed from local source.
#
# Differences from Dockerfile.docling-serve:
#   - Copies docling-glm-ocr and docling-pp-doc-layout from the repo instead
#     of pulling published packages from PyPI.
#   - Build context MUST be the repo root (parent of dcc-docling-serve/) so that
#     COPY can reach sibling directories.
#
# Used by compose.debug.yaml. Rebuild after every source change:
#   docker compose -f compose.yaml -f compose.debug.yaml build --no-cache

ARG DOCLING_SERVE_IMAGE=ghcr.io/docling-project/docling-serve
ARG DOCLING_SERVE_TAG=latest
FROM ${DOCLING_SERVE_IMAGE}:${DOCLING_SERVE_TAG}

RUN pip install --no-cache-dir "huggingface-hub>=1.3.0"

# Copy plugin source trees from the repo root build context
COPY docling-glm-ocr /src/docling-glm-ocr
COPY docling-pp-doc-layout /src/docling-pp-doc-layout

# Install from source — no PyPI lookup
RUN pip install --no-cache-dir --no-deps \
    /src/docling-glm-ocr \
    /src/docling-pp-doc-layout

# Mute health-probe log records (same as production)
COPY dcc-docling-serve/plugins/mute_health_logs.py /tmp/mute_health_logs.py
RUN SP="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && cp /tmp/mute_health_logs.py "$SP/dcc_mute_health_logs.py" \
    && printf 'import dcc_mute_health_logs\n' > "$SP/zz_dcc_mute_health_logs.pth"
